# ==========================================================
# NOLA Jazz WhatsApp Concierge - Configuración de entorno
# Copia este archivo a ".env" y rellena lo que necesites.
# ==========================================================

PORT=3000
NODE_ENV=development

# --- 1. Motor de IA (elige al menos uno; sin clave funciona el modo guiado offline) ---
# Recomendado: Google Gemini API (tiene capa gratuita en Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternativa opcional: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 2. Precios en vivo opcionales (SerpApi: 250 búsquedas/mes gratis) ---
# Sin esto, el bot usa estimaciones reales + enlaces directos a Google Flights / Booking
SERPAPI_API_KEY=

# --- 3. WhatsApp - Opción A: Meta WhatsApp Cloud API (Oficial, 1.000 msgs servicio/mes gratis) ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=nola-jazz-verify-2027
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- 4. WhatsApp - Opción B: Twilio Sandbox for WhatsApp (Arranque en 3 minutos) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# URL pública HTTPS (ej. https://tu-subdominio.ngrok-free.app) para validar firma de Twilio tras proxy
PUBLIC_BASE_URL=

# --- 5. Seguridad y Control de Acceso ---
# Lista separada por comas de teléfonos autorizados en formato internacional SIN '+' (o con '+'),
# ej: 34600112233,34699887766. Déjalo vacío en pruebas locales.
ALLOWED_PHONE_NUMBERS=
# En desarrollo permite probar webhooks Meta sin firma; en producción pon true
STRICT_WEBHOOK_SIGNATURE=false
# Nombre del viajero (para personalizar el trato en el chat)
TRAVELER_NAME=tu padre
